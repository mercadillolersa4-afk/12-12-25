/* styles.css
   Plantilla simple y moderna para una galería Pokémon.
   Mantener en un archivo separado llamado "styles.css".
*/

/* Reset y variables */
:root{
  --bg: #f7f7fb;
  --surface: #ffffff;
  --muted: #6b7280;
  --accent: #ef5350; /* rojo-poké */
  --accent-2: #ffcb05; /* amarillo */
  --card-shadow: 0 6px 18px rgba(15,23,42,0.08);
  --radius: 12px;
  --container-max: 1100px;
  --gap: 1.25rem;
  --txt-dark: #0f172a;
  --glass: rgba(255,255,255,0.6);
  font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
}

* { box-sizing: border-box; }
html,body { height:100%; }
body{
  margin:0;
  background: linear-gradient(180deg, var(--bg) 0%, #eef2f7 100%);
  color:var(--txt-dark);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  line-height:1.45;
  font-size:16px;
}

/* Utility: container */
.container{
  width:100%;
  max-width:var(--container-max);
  margin:0 auto;
  padding: 1.25rem;
}

/* Header */
.site-header{
  background: transparent;
  position:sticky;
  top:0;
  z-index:40;
  backdrop-filter: blur(6px);
  border-bottom: 1px solid rgba(15,23,42,0.04);
}
.header-inner{
  display:flex;
  gap:1rem;
  align-items:center;
  justify-content:space-between;
  padding:0.5rem 0;
}
.brand{
  display:flex;
  align-items:center;
  gap:0.75rem;
  text-decoration:none;
  color:var(--txt-dark);
}
.logo{ width:40px; height:40px; display:block; border-radius:8px; }
.site-title{ font-weight:700; font-size:1.125rem; letter-spacing:0.2px; }

/* Navigation */
.main-nav ul{
  display:flex;
  gap:0.75rem;
  list-style:none;
  margin:0;
  padding:0;
}
.main-nav a{
  text-decoration:none;
  color:var(--muted);
  padding:0.45rem 0.6rem;
  border-radius:8px;
  font-size:0.95rem;
}
.main-nav a:hover{ color:var(--txt-dark); background:rgba(15,23,42,0.04); }

/* Hero */
.hero{
  padding:2.2rem 0;
  text-align:left;
}
.hero .lead{ color:var(--muted); margin-top:0.25rem; margin-bottom:1rem; }
.hero h1{ margin:0 0 0.25rem 0; font-size:2rem; }

/* Search form */
.search-form{
  display:flex;
  gap:0.5rem;
  max-width:680px;
}
.search-form input[type="search"]{
  flex:1;
  padding:0.6rem 0.8rem;
  border-radius:10px;
  border:1px solid rgba(15,23,42,0.08);
  background:var(--surface);
  outline:none;
  font-size:1rem;
}
.search-form input::placeholder{ color: #9aa3b2; }
.search-form button{
  padding:0.6rem 0.9rem;
  border-radius:10px;
  border:0;
  background:linear-gradient(180deg,var(--accent) 0%, #d84343 100%);
  color:white;
  font-weight:600;
  cursor:pointer;
}
.search-form button:hover{ transform:translateY(-1px); }

/* Sections */
.section-title{ margin:1.25rem 0 0.5rem 0; font-size:1.25rem; }
.note{ color:var(--muted); margin-bottom:0.75rem; font-size:0.95rem; }

/* Grid de tarjetas */
.pokemon-grid{
  list-style:none;
  padding:0;
  margin:0;
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap:1rem;
}

/* Tarjeta individual */
.pokemon-card{
  background: linear-gradient(180deg, rgba(255,255,255,0.9), var(--surface));
  border-radius: var(--radius);
  box-shadow: var(--card-shadow);
  display:flex;
  gap:0.75rem;
  padding:0.9rem;
  align-items:center;
  transition: transform .18s ease, box-shadow .18s ease;
  border: 1px solid rgba(15,23,42,0.035);
}
.pokemon-card:hover{
  transform: translateY(-6px);
  box-shadow: 0 12px 30px rgba(15,23,42,0.12);
}

/* Media (imagen) */
.card-media{
  flex:0 0 110px;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0.25rem;
  background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(250,250,250,1));
  border-radius:10px;
}
.card-media img{ display:block; width:100px; height:100px; image-rendering: -webkit-optimize-contrast; }

/* Cuerpo de la tarjeta */
.card-body{ flex:1; min-width:0; }
.pokemon-name{ margin:0; font-size:1.05rem; }
.pokemon-meta{ margin:0.2rem 0; color:var(--muted); font-size:0.9rem; }
.pokemon-desc{ margin:0.45rem 0; color:#374151; font-size:0.95rem; }

/* Acciones */
.card-actions{
  display:flex;
  gap:0.5rem;
  align-items:center;
  margin-top:0.4rem;
}
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:0.4rem 0.6rem;
  border-radius:9px;
  text-decoration:none;
  border:1px solid rgba(15,23,42,0.06);
  background:transparent;
  color:var(--txt-dark);
  font-weight:600;
  font-size:0.95rem;
}
.btn:hover{ transform:translateY(-2px); }
.btn-primary{
  background: linear-gradient(180deg,var(--accent) 0%, #d94343 100%);
  color:white;
  border:0;
}

/* Tipos */
.types-grid{ display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center; }
.type-pill{
  padding:0.35rem 0.6rem;
  border-radius:999px;
  background:linear-gradient(90deg, rgba(255,255,255,0.7), rgba(250,250,250,0.9));
  border:1px solid rgba(15,23,42,0.04);
  font-weight:600;
  color:var(--muted);
  font-size:0.9rem;
}

/* Footer */
.site-footer{
  margin-top:2rem;
  padding:1.25rem 0;
  border-top:1px solid rgba(15,23,42,0.04);
  background:transparent;
}
.footer-inner{ display:flex; flex-direction:column; gap:0.25rem; text-align:center; color:var(--muted); font-size:0.95rem; }

/* Accesibilidad: oculto visual pero accesible */
.visually-hidden{
  position:absolute !important;
  height:1px;width:1px;
  overflow:hidden;
  clip:rect(1px,1px,1px,1px);
  white-space:nowrap;
}

/* Resposive tweaks */
@media (max-width:720px){
  .header-inner{ padding:0.4rem 0; }
  .hero h1{ font-size:1.5rem; }
  .pokemon-card{ flex-direction:row; padding:0.65rem; gap:0.6rem; }
  .card-media{ flex-basis:80px; }
  .card-media img{ width:80px; height:80px; }
  .search-form{ flex-direction:column; gap:0.5rem; }
  .main-nav ul{ display:none; } /* navegación simplificada en móvil (puedes añadir un menú hamburguesa) */
}
